{
  "$schema": "https://opencode.ai/config.json",
  // AGENTS.md loads on its own. These are the generated rules
  // (every .cursor/rules file).
  "instructions": [".agents/rules/*.md"],
  "mcp": {
    "servers": {
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
        "oauth": false,
        "headers": {
          "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}",
        },
      },
      "browse": {
        "type": "local",
        "command": ["browse", "mcp"],
      },
    },
  },
}
